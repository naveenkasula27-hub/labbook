# Copy this file to .env and fill in the values.

PORT=4000
NODE_ENV=development

# Local MongoDB. For MongoDB Atlas, paste the connection string here instead.
MONGODB_URI=mongodb://127.0.0.1:27017/labbook

# Any long random string. Used to sign login tokens.
JWT_SECRET=change-this-to-a-long-random-string

# Where the React app runs, so the browser is allowed to call this API.
CLIENT_ORIGIN=http://localhost:5173

# --- WhatsApp (Meta Cloud API) ---
# Leave these blank to start. Bookings still work; no WhatsApp message is sent.
# Get them from developers.facebook.com once your app is set up.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# You choose this string, then type the same one into Meta's webhook setup.
WHATSAPP_VERIFY_TOKEN=
# Meta shows this in App Settings > Basic. Used to check incoming webhooks are real.
WHATSAPP_APP_SECRET=
